{
  "name": "aas-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "katex": "^0.16.23",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-katex": "^3.1.0",
    "react-router-dom": "^7.18.2",
    "react-toastify": "^11.0.5",
    "three": "^0.185.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=development react-scripts start",
    "start:prod": "serve -s build",
    "build": "react-scripts build",
    "build:prod": "cross-env REACT_APP_ENV=production react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "postbuild": "node -e \"require('fs').copyFileSync('.htaccess', 'build/.htaccess')\""
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "cross-env": "^7.0.3",
    "npm-run-all": "^4.1.5",
    "react-scripts": "^5.0.1",
    "serve": "^14.2.6"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
