<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Never cache HTML (always get fresh version)
  ExpiresByType text/html "access plus 0 seconds"
  
  # Cache versioned assets for 1 year (they have content hashes)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/x-font-woff "access plus 1 year"
  ExpiresByType application/x-font-ttf "access plus 1 year"
  ExpiresByType application/x-font-otf "access plus 1 year"
  
  # Cache CSS and JS for shorter time (they have content hashes in names)
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType application/x-javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  
  # Short cache for videos - they may change
  ExpiresByType video/mp4 "access plus 1 day"
  ExpiresByType video/quicktime "access plus 1 day"
</IfModule>

# Cache control headers
<IfModule mod_headers.c>
  # Don't cache HTML
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
  </FilesMatch>
  
  # Short cache for videos
  <FilesMatch "\.(mp4|webm|mov)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json
</IfModule>
