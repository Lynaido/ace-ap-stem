# Backend Production Environment Configuration
# Copy this file to .env.production and fill in your actual production values

# Server Configuration
PORT=3001
NODE_ENV=production
API_BASE_URL=https://api.aceapstem.com

# Database Configuration
# Production PostgreSQL database (Supabase or other provider)
# Use connection pooling (pgbouncer) for application runtime
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&sslmode=require"

# Direct connection for Prisma migrations
DIRECT_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# JWT Configuration
# IMPORTANT: Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# DO NOT use the development secrets in production!
JWT_SECRET=REPLACE-WITH-STRONG-SECRET-64-CHARS
JWT_REFRESH_SECRET=REPLACE-WITH-STRONG-REFRESH-SECRET-128-CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth Configuration
# Update with production credentials from Google Cloud Console
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret
GOOGLE_CALLBACK_URL=https://api.aceapstem.com/auth/google/callback

# OpenAI Configuration
# Use a production API key with appropriate rate limits
OPENAI_API_KEY=your-production-openai-api-key
OPENAI_TIMEOUT_MS=120000
OPENAI_CONCEPT_NOTES_TIMEOUT_MS=150000

# Redis Configuration
# Use production Redis instance (Redis Cloud, Upstash, or self-hosted)
REDIS_URL=redis://username:password@hostname:port

# CORS Configuration
# Your production frontend domain
FRONTEND_URL=https://aceapstem.com

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# Logging
LOG_LEVEL=info
