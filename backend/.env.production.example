# Server Configuration
PORT=3001
NODE_ENV=production
API_BASE_URL=https://api.yourdomain.com

# Database Configuration - Update with Hostinger database credentials
DATABASE_URL=postgresql://username:password@hostname:5432/database_name?schema=public

# JWT Configuration - IMPORTANT: Generate strong secrets for production!
JWT_SECRET=generate-a-strong-random-secret-here-min-32-chars
JWT_REFRESH_SECRET=generate-another-strong-random-secret-here-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth Configuration - Update with production URLs
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_TIMEOUT_MS=120000
OPENAI_CONCEPT_NOTES_TIMEOUT_MS=150000

# Redis Configuration
# If Hostinger provides Redis: redis://hostname:6379
# If using external Redis (e.g., Redis Cloud): redis://username:password@hostname:port
REDIS_URL=redis://localhost:6379

# CORS Configuration - Update with your frontend domain
FRONTEND_URL=https://yourdomain.com

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# Logging
LOG_LEVEL=info
