# Frontend Environment Configuration
# Copy this file to .env and fill in your actual values

# API Configuration
REACT_APP_API_URL=http://localhost:3001

# Development Settings
REACT_APP_ENV=development
REACT_APP_VERSION=1.0.0

# Feature Flags (uncomment and set to 'true' to enable)
# REACT_APP_ENABLE_ANALYTICS=false
# REACT_APP_ENABLE_DEBUG_MODE=false

# External Services (add your actual keys here)
# REACT_APP_GOOGLE_ANALYTICS_ID=
# REACT_APP_SENTRY_DSN=

# Note: Never commit your actual .env file with real secrets!
# This .env.example file is safe to commit to version control.
